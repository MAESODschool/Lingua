rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isTeacherOrAdmin() {
      return signedIn() && (
        request.auth.token.get('teacher', false) == true ||
        request.auth.token.get('admin', false) == true
      );
    }

    // The dashboard PIN is only a client-side UI gate. Real teacher access must
    // come from a custom claim set by a trusted backend or the Admin SDK.
    function isTeacher() {
      return isTeacherOrAdmin() || (
        signedIn() && request.auth.token.get('role', '') == 'teacher'
      );
    }

    function isAssetManager() {
      return isTeacher() || (
        signedIn() && request.auth.token.get('assetManager', false) == true
      );
    }

    function ownerPlayerCreateKeys() {
      return [
        'uid',
        'authUid',
        'username',
        'usernameLower',
        'loginEmail',
        'displayName',
        'mode',
        'accountMode',
        'profileCompleted',
        'characterCreated',
        'characterId',
        'characterName',
        'characterGender',
        'avatarId',
        'avatarImage',
        'studentProfile',
        'studentFullName',
        'classLevel',
        'room',
        'studentNo',
        'classGroup',
        'classGroupKey',
        'studentSortKey',
        'avatar',
        'settings',
        'preferences',
        'tutorialState',
        'hasSeenPrologue',
        'createdAt',
        'updatedAt',
        'lastLoginAt',
        'lastActiveAt'
      ];
    }

    function ownerPlayerUpdateKeys() {
      return [
        'displayName',
        'profileCompleted',
        'characterCreated',
        'characterId',
        'characterName',
        'characterGender',
        'avatarId',
        'avatarImage',
        'studentProfile',
        'studentFullName',
        'classLevel',
        'room',
        'studentNo',
        'classGroup',
        'classGroupKey',
        'studentSortKey',
        'avatar',
        'settings',
        'preferences',
        'tutorialState',
        'hasSeenPrologue',
        'updatedAt',
        'lastLoginAt',
        'lastActiveAt'
      ];
    }

    function protectedPlayerKeys() {
      return [
        'grammaria',
        'progress',
        'progressPercent',
        'currentLessonTitle',
        'currentAreaTitle',
        'nextGoalTitle',
        'bossesDefeated',
        'completedStages',
        'unlockedStages',
        'defeatedBosses',
        'rewardClaims',
        'bossPracticeScores',
        'vsBossAssessmentRecords',
        'vsBossScoreHistory',
        'verbMemoryPracticeBest',
        'assessmentRecords',
        'officialAssessment',
        'verifiedAssessment',
        'teacherAssessment',
        'teacherNotes',
        'teacherFlags',
        'teacherAdjustments',
        'manualGrammariaAdjustedAt',
        'manualGrammariaAdjustedBy',
        'manualGrammariaAdjustReason',
        'manualGrammariaLastDelta',
        'isDeleted',
        'deletedAt',
        'deletedBy',
        'deleteReason',
        'restoredAt',
        'restoredBy',
        'restoreReason',
        'role',
        'roles',
        'claims',
        'admin',
        'teacher',
        'isAdmin',
        'isTeacher'
      ];
    }

    function teacherPlayerUpdateKeys() {
      return [
        'grammaria',
        'teacherNotes',
        'teacherFlags',
        'teacherAdjustments',
        'officialAssessment',
        'verifiedAssessment',
        'teacherAssessment',
        'isDeleted',
        'deletedAt',
        'deletedBy',
        'deleteReason',
        'restoredAt',
        'restoredBy',
        'restoreReason',
        'manualGrammariaAdjustedAt',
        'manualGrammariaAdjustedBy',
        'manualGrammariaAdjustReason',
        'manualGrammariaLastDelta',
        'updatedAt'
      ];
    }

    function ownerPlayerCreateIsValid(playerId) {
      return request.resource.data.keys().hasOnly(ownerPlayerCreateKeys())
        && request.resource.data.uid == playerId
        && request.resource.data.authUid == playerId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 80;
    }

    function ownerPlayerUpdateIsValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerPlayerUpdateKeys())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedPlayerKeys());
    }

    function teacherPlayerUpdateIsValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(teacherPlayerUpdateKeys());
    }

    function gameAssetOverrideKeys() {
      return [
        'key',
        'category',
        'displayName',
        'defaultPath',
        'activeUrl',
        'storagePath',
        'fileName',
        'contentType',
        'fileSize',
        'isActive',
        'updatedAt',
        'updatedBy',
        'note',
        'resetAt',
        'resetBy'
      ];
    }

    function gameAssetOverrideCreateIsValid(assetKey) {
      return request.resource.data.keys().hasOnly(gameAssetOverrideKeys())
        && request.resource.data.keys().hasAll([
          'key',
          'category',
          'displayName',
          'defaultPath',
          'activeUrl',
          'storagePath',
          'fileName',
          'contentType',
          'fileSize',
          'isActive',
          'updatedAt',
          'updatedBy',
          'note'
        ])
        && request.resource.data.key == assetKey
        && request.resource.data.isActive == true
        && request.resource.data.activeUrl is string
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches('game-assets/.*')
        && request.resource.data.contentType is string
        && request.resource.data.contentType.matches('image/(png|jpeg|webp|gif)')
        && request.resource.data.fileSize is int
        && request.resource.data.fileSize > 0
        && request.resource.data.fileSize <= 5 * 1024 * 1024;
    }

    function gameAssetOverrideUpdateIsValid(assetKey) {
      return request.resource.data.keys().hasOnly(gameAssetOverrideKeys())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(gameAssetOverrideKeys())
        && request.resource.data.key == assetKey
        && request.resource.data.isActive is bool
        && (
          request.resource.data.isActive == false || (
            request.resource.data.activeUrl is string
            && request.resource.data.storagePath is string
            && request.resource.data.storagePath.matches('game-assets/.*')
            && request.resource.data.contentType is string
            && request.resource.data.contentType.matches('image/(png|jpeg|webp|gif)')
            && request.resource.data.fileSize is int
            && request.resource.data.fileSize > 0
            && request.resource.data.fileSize <= 5 * 1024 * 1024
          )
        );
    }

    function clientProgressCreateIsValid(playerId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'authUid',
          'schemaVersion',
          'clientReported',
          'progress',
          'createdAt',
          'updatedAt',
          'lastActiveAt'
        ])
        && request.resource.data.uid == playerId
        && request.resource.data.authUid == playerId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clientReported == true
        && request.resource.data.progress is map;
    }

    function clientProgressUpdateIsValid(playerId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'schemaVersion',
          'clientReported',
          'progress',
          'updatedAt',
          'lastActiveAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.uid == playerId
        && request.resource.data.authUid == playerId
        && request.resource.data.schemaVersion == 1
        && request.resource.data.clientReported == true
        && request.resource.data.progress is map;
    }

    function pvpRoomDoesNotExist(roomId) {
      return !exists(/databases/$(database)/documents/pvpRooms/$(roomId));
    }

    function isPvpParticipant() {
      return signedIn() && (
        resource.data.playerAUid == request.auth.uid ||
        resource.data.get('playerBUid', '') == request.auth.uid
      );
    }

    function keepsPvpRoomIdentity() {
      return request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.playerAUid == resource.data.playerAUid
        && request.resource.data.get('playerBUid', '') == resource.data.get('playerBUid', '');
    }

    function isJoiningAsPlayerB() {
      return signedIn()
        && resource.data.status == 'waiting'
        && resource.data.get('playerBUid', '') == ''
        && resource.data.playerAUid != request.auth.uid
        && request.resource.data.roomCode == resource.data.roomCode
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.playerAUid == resource.data.playerAUid
        && request.resource.data.playerBUid == request.auth.uid
        && request.resource.data.guestUid == request.auth.uid
        && request.resource.data.status == 'playing'
        && request.resource.data.players.A == resource.data.players.A
        && request.resource.data.players.B.uid == request.auth.uid
        && request.resource.data.lanes.A == resource.data.lanes.A
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'playerBUid',
          'guestUid',
          'players',
          'lanes',
          'status',
          'updatedAt'
        ]);
    }

    match /players/{playerId} {
      allow get: if isOwner(playerId) || isTeacher();
      allow list: if isTeacher();
      allow create: if isOwner(playerId) && ownerPlayerCreateIsValid(playerId);
      allow update: if (
        isOwner(playerId) && ownerPlayerUpdateIsValid()
      ) || (
        isTeacher() && teacherPlayerUpdateIsValid()
      );
      allow delete: if false;
    }

    // This document is explicitly client-reported. It preserves cross-device
    // prototype saves but is not trusted assessment evidence or an official score.
    match /playerClientProgress/{playerId} {
      allow get: if isOwner(playerId) || isTeacher();
      allow list: if isTeacher();
      allow create: if isOwner(playerId) && clientProgressCreateIsValid(playerId);
      allow update: if isOwner(playerId) && clientProgressUpdateIsValid(playerId);
      allow delete: if false;
    }

    match /pvpRooms/{roomId} {
      // Reading a missing random room code reveals no player data and lets the
      // creator safely check for a collision before creating the room.
      allow get: if pvpRoomDoesNotExist(roomId) || isPvpParticipant() || isTeacher();
      allow list: if isTeacher();
      allow create: if signedIn()
        && request.resource.data.keys().hasAll([
          'roomCode',
          'status',
          'hostUid',
          'guestUid',
          'playerAUid',
          'playerBUid',
          'players',
          'lanes'
        ])
        && request.resource.data.roomCode == roomId
        && request.resource.data.status == 'waiting'
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.playerAUid == request.auth.uid
        && request.resource.data.playerBUid == ''
        && request.resource.data.guestUid == '';
      allow update: if isTeacher()
        || (isPvpParticipant() && keepsPvpRoomIdentity())
        || isJoiningAsPlayerB();
      allow delete: if false;
    }

    match /adminLogs/{logId} {
      allow read, create: if isTeacher();
      allow update, delete: if false;
    }

    match /gameAssetOverrides/{assetKey} {
      allow read: if signedIn();
      allow create: if isAssetManager() && gameAssetOverrideCreateIsValid(assetKey);
      allow update: if isAssetManager() && gameAssetOverrideUpdateIsValid(assetKey);
      allow delete: if false;
    }

    // PvP remains a client-driven prototype. Competitive validation and strict
    // state transitions should move to trusted Cloud Functions in a later phase.
  }
}
